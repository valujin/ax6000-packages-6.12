msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ru\n"

msgid "MediaTek Mesh"
msgstr "MediaTek Mesh"

msgid "The router did not complete the operation."
msgstr "Роутер не завершил операцию."

msgid "Main router (controller)"
msgstr "Основной роутер (контроллер)"

msgid "Additional node (agent)"
msgstr "Дополнительный узел (агент)"

msgid "Ethernet cable"
msgstr "Кабель Ethernet"

msgid "Wi-Fi"
msgstr "Wi-Fi"

msgid "Mesh is disabled"
msgstr "Mesh выключен"

msgid "Mesh services are running"
msgstr "Службы Mesh запущены"

msgid "Mesh services are not running"
msgstr "Службы Mesh не запущены"

msgid "Unable to read Mesh status: "
msgstr "Не удалось получить состояние Mesh: "

msgid "Connect Redmi AX6000 routers running this firmware into one network using MediaTek EasyMesh."
msgstr "Объедините роутеры Redmi AX6000 с нашей прошивкой в одну сеть с помощью MediaTek EasyMesh."

msgid "Setup"
msgstr "Настройка"

msgid "Role"
msgstr "Роль"

msgid "Connection between routers"
msgstr "Соединение между роутерами"

msgid "Preparing Mesh…"
msgstr "Подготовка Mesh…"

msgid "Waiting for connection or pairing…"
msgstr "Ожидание соединения или сопряжения…"

msgid "Obtaining the management address…"
msgstr "Получение адреса управления…"

msgid "Checking the connection…"
msgstr "Проверка соединения…"

msgid "Mesh node connected"
msgstr "Узел Mesh подключён"

msgid "Setup failed; previous settings restored"
msgstr "Настройка не удалась; прежние настройки восстановлены"

msgid "Restoring previous settings…"
msgstr "Восстановление прежних настроек…"

msgid "A running service does not mean a node has joined."
msgstr "Запуск службы не означает, что узел подключён."

msgid "Pairing time remaining (seconds): "
msgstr "До окончания сопряжения (секунд): "

msgid "Mesh nodes"
msgstr "Узлы Mesh"

msgid "No joined nodes reported."
msgstr "Подключённые узлы не обнаружены."

msgid "Unknown node"
msgstr "Неизвестный узел"

msgid "Address unknown"
msgstr "Адрес неизвестен"

msgid "Enable Mesh on the main router. For a Wi-Fi node, select Add a node here, then start joining on the additional node while the pairing window is open."
msgstr "Включите Mesh на основном роутере. Для подключения узла по Wi-Fi нажмите здесь «Добавить узел», затем начните подключение на дополнительном узле, пока окно сопряжения открыто."

msgid "For Ethernet, connect the additional node WAN port to a LAN port on the main router. For Wi-Fi, keep the routers nearby and open pairing on the main router before joining."
msgstr "Для соединения по кабелю подключите порт WAN дополнительного узла к порту LAN основного роутера. Для Wi-Fi расположите роутеры рядом и откройте сопряжение на основном роутере перед подключением узла."

msgid "Enable Mesh"
msgstr "Включить Mesh"

msgid "Join Mesh"
msgstr "Подключиться к Mesh"

msgid "Add a node"
msgstr "Добавить узел"

msgid "Disable Mesh and restore settings"
msgstr "Выключить Mesh и восстановить настройки"

msgid "The additional node may have a new address. Check the main router’s DHCP lease list. If setup fails, recovery is attempted; check the error and retry restoration if needed."
msgstr "Адрес дополнительного узла мог измениться. Проверьте список DHCP-аренд основного роутера. При ошибке настройки выполняется попытка восстановления; проверьте сообщение об ошибке и при необходимости повторите восстановление."

msgid "The main router keeps its Wi-Fi names and passwords. The additional node receives its settings automatically. Wi-Fi may briefly disconnect during setup."
msgstr "Основной роутер сохраняет имена и пароли Wi-Fi. Дополнительный узел получает настройки автоматически. Во время настройки Wi-Fi может ненадолго отключиться."

msgid "The additional node obtains its management address automatically, so this page may disconnect. Check the main router’s DHCP lease list for the address. If joining fails, recovery is attempted; check the error and retry restoration if needed."
msgstr "Дополнительный узел получает адрес управления автоматически, поэтому соединение с этой страницей может прерваться. Найдите адрес в списке DHCP-аренд основного роутера. При ошибке подключения выполняется попытка восстановления; проверьте сообщение об ошибке и при необходимости повторите восстановление."

msgid "Restore previous settings"
msgstr "Восстановить прежние настройки"
