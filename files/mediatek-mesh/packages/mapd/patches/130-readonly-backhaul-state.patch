+#ifdef SUPPORT_MULTI_AP
+/* Numeric diagnostics only: do not expose configuration or alter state. */
+static int mapd_get_bh_state(const struct mapd_global *global,
+		char *reply, size_t reply_size)
+{
+	int len;
+
+	len = os_snprintf(reply, reply_size,
+		"bh_state=%u ethernet_state=%u config_status=%u "
+		"configured_state=%u auto_switch=%u certification=%u\n",
+		(unsigned int)global->dev.current_bh_state,
+		(unsigned int)BH_STATE_ETHERNET_PLUGGED,
+		(unsigned int)global->dev.config_status,
+		(unsigned int)DEVICE_CONFIGURED,
+		(unsigned int)global->dev.auto_bh_switch,
+		(unsigned int)global->params.Certification);
+	if (os_snprintf_error(reply_size, len))
+		return -1;
+	return len;
+}
+#endif
