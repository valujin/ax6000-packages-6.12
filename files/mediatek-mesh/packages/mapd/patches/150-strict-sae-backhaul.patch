--- a/mapd_interface/mesh_bh_security.inc
+++ b/mapd_interface/mesh_bh_security.inc
@@ -0,0 +1,79 @@
+/* Pinned mt_wifi 7.6.7.3 cmm_info.c RTMPIoctlGetMacTableStaInfo exports
+ * negotiated peer AKM/cipher, unlike OID_GET_SECURITY_TYPE (AP config).
+ * Keep this private query ABI separate from the prebuilt mapd blob ABI. */
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/ioctl.h>
+#include <linux/wireless.h>
+struct mesh_bh_mac_entry {
+	uint8_t index, mac[6];
+	uint16_t aid;
+	uint8_t psm, mimo;
+	int8_t rssi[4];
+	uint32_t connected, tx_rate, rx_rate;
+	int16_t stream_snr[3], sounding_snr[3];
+	uint32_t cipher, auth;
+};
+struct mesh_bh_mac_table {
+	unsigned long count;
+	struct mesh_bh_mac_entry entries[544];
+};
+_Static_assert(sizeof(unsigned long) == 8, "AX6000 driver ABI requires 64-bit ULONG");
+_Static_assert(sizeof(struct mesh_bh_mac_entry) == 48, "driver station entry ABI");
+_Static_assert(offsetof(struct mesh_bh_mac_entry, auth) == 44, "driver AKM offset");
+_Static_assert(sizeof(struct mesh_bh_mac_table) == 26120, "driver station table ABI");
+static int mesh_bh_peer_sae(const char *ifname, const unsigned char *bssid)
+{
+	struct mesh_bh_mac_table *table;
+	struct iwreq request;
+	int fd, valid = 0;
+
+	if (strcmp(ifname, "apcli0") && strcmp(ifname, "apclix0"))
+		return 0;
+	fd = socket(AF_INET, SOCK_DGRAM, 0);
+	if (fd < 0)
+		return 0;
+	/* The vendor ioctl does not check the supplied capacity before copying.
+	 * Reserve its complete 16-bit output space and reject a different ABI. */
+	table = calloc(1, 65535);
+	if (!table) {
+		close(fd);
+		return 0;
+	}
+	memset(&request, 0, sizeof(request));
+	strcpy(request.ifr_name, ifname);
+	request.u.data.pointer = table;
+	request.u.data.length = sizeof(*table);
+	if (ioctl(fd, SIOCIWFIRSTPRIV + 0x1f, &request) == 0 &&
+	    request.u.data.length == sizeof(*table) && table->count == 1 &&
+	    !memcmp(table->entries[0].mac, bssid, 6) &&
+	    table->entries[0].auth == (1U << 13) && /* SEC_AKM_SAE_SHA256 */
+	    table->entries[0].cipher == (1U << 5)) /* SEC_CIPHER_CCMP128 */
+		valid = 1;
+	free(table);
+	close(fd);
+	return valid;
+}
+static int mesh_bh_security(struct mapd_global *global, char *reply, size_t size)
+{
+	struct bh_link_entry *entry, *next;
+	unsigned int seen = 0, count = 0;
+	int valid = 1, len;
+
+	SLIST_FOREACH_SAFE(entry, &global->dev.bh_link_head, next_bh_link, next) {
+		unsigned int bit;
+		if (entry->bh_assoc_state != WAPP_APCLI_ASSOCIATED)
+			continue;
+		if (++count > 2) { valid = 0; break; }
+		if (!memcmp(entry->ifname, "apcli0\0", 7)) bit = 1;
+		else if (!memcmp(entry->ifname, "apclix0\0", 8)) bit = 2;
+		else { valid = 0; break; }
+		if ((seen & bit) || !mesh_bh_peer_sae((char *)entry->ifname, entry->bssid)) {
+			valid = 0;
+			break;
+		}
+		seen |= bit;
+	}
+	len = snprintf(reply, size, "sae=%d\n", valid && seen ? 1 : 0);
+	return len < 0 || (size_t)len >= size ? -1 : len;
+}
