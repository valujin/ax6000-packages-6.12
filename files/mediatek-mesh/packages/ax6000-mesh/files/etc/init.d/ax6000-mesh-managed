#!/bin/sh /etc/rc.common
# Independent post-commit worker: initial two-slot enrollment stays unchanged.
START=98
STOP=8
USE_PROCD=1
start_service() {
 procd_open_instance bootstrap
 procd_set_param command /usr/libexec/ax6000-mesh-managed-bootstrap monitor
 procd_set_param respawn 3600 2 0
 procd_set_param term_timeout 20
 procd_close_instance
}
reload_service() {
 # No configuration/bridge mutation in the trigger or procd request handler.
 umask 077
 : > /var/run/ax6000-mesh-managed-request
}
service_triggers() {
 procd_add_reload_trigger ax6000_mesh network wireless
}
