#!/bin/sh /etc/rc.common
USE_PROCD=1

start_service() {
  state=$(cat /var/run/ax6000-mesh-operation/state 2>/dev/null)
  case "$state" in applying) method=apply ;; disabling) method=disable ;; *) return 1 ;; esac
  procd_open_instance job
  procd_set_param command /usr/libexec/ax6000-mesh-job "$method"
  procd_close_instance
}
