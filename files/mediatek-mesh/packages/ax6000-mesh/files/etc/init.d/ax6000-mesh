#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
  local mesh_role mesh_flag mesh_security mesh_linux_ts
  [ "$(uci -q get ax6000_mesh.main.enabled)" = 1 ] || return 0
  /usr/libexec/ax6000-mesh-transaction present || return 1
  mesh_security=psk2
  if [ "$(uci -q get ax6000_mesh.main.role)" = agent ] && [ "$(uci -q get ax6000_mesh.main.backhaul)" = wireless ]; then
    mesh_security=$(uci -q get ax6000_mesh.main.backhaul_security 2>/dev/null) || mesh_security=psk2
    case "$mesh_security" in sae|psk2) ;; *) return 1 ;; esac
    if [ "$mesh_security" = sae ] && [ "$(cat /etc/ax6000-mesh/phase 2>/dev/null)" = committed ]; then
      /usr/libexec/ax6000-mesh-profile saved || return 1
    fi
  fi
  /usr/libexec/ax6000-mesh-control prepare || return 1
  # radio-ready owns the Mesh lock across restart. Share it only for the
  # synchronous preparation check, never with helpers or daemon instances.
  exec 9>&-
  # Wait for both owned BH interfaces to join br-lan before daemon startup.
  local hairpin_now hairpin_deadline
  read -r hairpin_now _ < /proc/uptime; hairpin_now=${hairpin_now%%.*}
  hairpin_deadline=$((hairpin_now + 30))
  until timeout 3 /usr/libexec/ax6000-mesh-hairpin apply; do
    read -r hairpin_now _ < /proc/uptime; hairpin_now=${hairpin_now%%.*}
    [ "$hairpin_now" -lt "$hairpin_deadline" ] || { echo 'Cannot disable Mesh backhaul hairpin.' >&2; return 1; }
    sleep 1
  done
  mesh_role=$(uci -q get ax6000_mesh.main.role)
  case "$mesh_role" in controller) mesh_flag=-r0 ;; agent) mesh_flag=-r1 ;; *) return 1 ;; esac
  procd_open_instance hairpin
  procd_set_param command /usr/libexec/ax6000-mesh-hairpin monitor
  procd_set_param respawn 3600 5 5
  procd_close_instance
  procd_open_instance wapp
  procd_set_param command /usr/bin/wapp -n -d1 -v2 -cra0 -crax0 -F /etc/map/mapd_cfg -u /etc/map/mapd_user.cfg
  procd_set_param respawn 3600 5 5
  procd_close_instance
  mesh_linux_ts=$(uci -q get ax6000_mesh.main.linux_ts 2>/dev/null) || mesh_linux_ts=0
  procd_open_instance p1905
  [ "$mesh_linux_ts" != 1 ] || procd_set_param env "AX6000_MESH_LINUX_TS=1"
  procd_set_param command /usr/libexec/ax6000-mesh-wait /tmp/wapp_ctrl /usr/bin/p1905_managerd "$mesh_flag" -f /etc/map/1905d.cfg -F /etc/map/wts_bss_info_config
  procd_set_param respawn 3600 5 5
  procd_close_instance
  procd_open_instance mapd
  procd_set_param env "AX6000_MESH_BACKHAUL_SECURITY=$mesh_security"
  [ "$mesh_linux_ts" != 1 ] || procd_append_param env "AX6000_MESH_LINUX_TS=1"
  procd_set_param command /usr/libexec/ax6000-mesh-wait @1905_daemon /usr/bin/mapd -I /etc/map/mapd_cfg -O /etc/mapd_strng.conf
  procd_set_param respawn 3600 5 5
  procd_close_instance
  if [ "$mesh_role" = agent ] && [ "$(uci -q get ax6000_mesh.main.backhaul)" = wired ]; then
    procd_open_instance wired
    procd_set_param command /usr/libexec/ax6000-mesh-wired monitor
    procd_set_param respawn 3600 5 5
    procd_close_instance
  fi
}

service_triggers() {
  procd_add_reload_trigger ax6000_mesh
}
