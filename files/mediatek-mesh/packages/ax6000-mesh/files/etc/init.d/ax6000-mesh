#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
  local mesh_role mesh_flag
  [ "$(uci -q get ax6000_mesh.main.enabled)" = 1 ] || return 0
  /usr/libexec/ax6000-mesh-transaction present || return 1
  /usr/libexec/ax6000-mesh-control prepare || return 1
  mesh_role=$(uci -q get ax6000_mesh.main.role)
  case "$mesh_role" in controller) mesh_flag=-r0 ;; agent) mesh_flag=-r1 ;; *) return 1 ;; esac
  procd_open_instance wapp
  procd_set_param command /usr/bin/wapp -n -d1 -v2 -cra0 -crax0 -F /etc/map/mapd_cfg -u /etc/map/mapd_user.cfg
  procd_set_param respawn 3600 5 5
  procd_close_instance
  procd_open_instance p1905
  procd_set_param command /usr/libexec/ax6000-mesh-wait /tmp/wapp_ctrl /usr/bin/p1905_managerd "$mesh_flag" -f /etc/map/1905d.cfg -F /etc/map/wts_bss_info_config
  procd_set_param respawn 3600 5 5
  procd_close_instance
  procd_open_instance mapd
  procd_set_param command /usr/libexec/ax6000-mesh-wait @1905_daemon /usr/bin/mapd -I /etc/map/mapd_cfg -O /etc/mapd_strng.conf
  procd_set_param respawn 3600 5 5
  procd_close_instance
}

service_triggers() {
  procd_add_reload_trigger ax6000_mesh
}
