#!/bin/sh /etc/rc.common
# Separate supervisor service: controller topology changes may restart native Mesh.
START=100
STOP=9
USE_PROCD=1
start_service() {
  [ "$(uci -q get ax6000_mesh.main.enabled)" = 1 ] && [ "$(uci -q get ax6000_mesh.main.linux_ts)" = 1 ] || return 0
  /usr/libexec/ax6000-mesh-transaction present || return 1
  case "$(uci -q get ax6000_mesh.main.role)" in
    controller) sync_helper=/usr/libexec/ax6000-mesh-controller-sync ;;
    agent) sync_helper=/usr/libexec/ax6000-mesh-agent-sync ;;
    *) return 1 ;;
  esac
  procd_open_instance policy
  procd_set_param command "$sync_helper" monitor
  procd_set_param respawn 3600 2 0
  procd_close_instance
  procd_open_instance observe
  procd_set_param command /usr/libexec/ax6000-mesh-ts-observe monitor
  procd_set_param respawn 3600 2 0
  procd_close_instance
}
reload_service() {
  # Watchers normalize current committed UCI and retry native renewal. A reload
  # never kills a worker halfway through a publication journal.
  : > /var/run/ax6000-mesh-sync-request
}
stop_service() {
  /usr/libexec/ax6000-mesh-ts-supervise stop >/dev/null 2>&1 || :
  /usr/libexec/ax6000-mesh-ts-runtime quarantine >/dev/null 2>&1 || :
}
service_triggers() {
  procd_add_reload_trigger wireless network dhcp firewall ax6000_mesh
}
