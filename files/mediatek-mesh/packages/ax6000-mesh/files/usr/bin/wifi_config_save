#!/bin/sh
# Persist the daemon-owned fields for the two supported AX6000 mesh BSSs.
set -eu
LC_ALL=C
export LC_ALL
umask 077
fail() { printf '%s\n' "$*" >&2; exit 1; }
[ "$#" = 3 ] || fail 'Expected interface, field and value.'
case "$1" in
  ra0) profile=/etc/wireless/mediatek/mt7986-ax6000.dbdc.b0.dat ;;
  rax0) profile=/etc/wireless/mediatek/mt7986-ax6000.dbdc.b1.dat ;;
  apcli0|apclix0) exit 0 ;;
  *) fail 'Unsupported mesh interface.' ;;
esac
field=$2
value=$3
case "$field" in
  SSID) [ "${#value}" -ge 1 ] && [ "${#value}" -le 32 ] || fail 'Invalid SSID length.'; field=SSID1 ;;
  WPAPSK) [ "${#value}" -ge 8 ] && [ "${#value}" -le 63 ] || fail 'Invalid WPA key length.'; field=WPAPSK1 ;;
  AuthMode) [ "$value" = WPA2PSK ] || fail 'Unsupported authentication mode.' ;;
  EncrypType) [ "$value" = AES ] || fail 'Unsupported encryption type.' ;;
  HideSSID) [ "$value" = 0 ] || fail 'Hidden mesh APs are unsupported.' ;;
  Channel) case "$value" in ''|*[!0-9]*) fail 'Invalid channel.' ;; esac; [ "$value" -ge 1 ] && [ "$value" -le 196 ] || fail 'Invalid channel.' ;;
  *) fail 'Unsupported wireless field.' ;;
esac
case "$value" in *[![:print:]]*) fail 'Wireless values must be printable ASCII.' ;; esac
[ "$(uci -q get ax6000_mesh.main.enabled 2>/dev/null || :)" = 1 ] || fail 'Mesh is disabled.'
[ -f "$profile" ] || fail 'Mesh radio profile is missing.'
exec 9>/var/lock/mtwifi.lock
attempt=0
while ! flock -n 9; do
  attempt=$((attempt + 1)); [ "$attempt" -lt 30 ] || fail 'Wireless configuration is busy.'; sleep 1
done
if [ "$field" = Channel ] && [ "$(datconf -f "$profile" get AutoChannelSelect 2>/dev/null || :)" = 3 ]; then exit 0; fi
case "$field" in
  AuthMode|EncrypType|HideSSID)
    previous=$(datconf -f "$profile" get "$field" 2>/dev/null || :)
    case "$previous" in *';'*) value="$value;${previous#*;}" ;; esac
    ;;
esac
datconf -f "$profile" set "$field" "$value" >/dev/null 2>&1 || fail 'Could not persist the mesh wireless setting.'
