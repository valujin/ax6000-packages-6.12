#!/bin/sh
# Check the private persistent vendor profile without printing credentials.
set -eu
LC_ALL=C; export LC_ALL
profile=/etc/map/mapd_user.cfg
if [ "${1:-}" = reset ]; then
  [ ! -L "$profile" ] || exit 1
  [ -e "$profile" ] || exit 0
  [ -f "$profile" ] && [ -w "$profile" ] || exit 1
  umask 077
  temporary=$(mktemp "${profile}.XXXXXX") || exit 1
  trap 'rm -f "$temporary"' EXIT
  trap 'exit 1' HUP INT TERM
  sed -E '/^BhProfile[0-9](Valid|Ssid|AuthMode|EncrypType|WpaPsk|RaID)=/d' "$profile" > "$temporary" || exit 1
  chmod 600 "$temporary" && mv -f "$temporary" "$profile" || exit 1
  exit 0
fi
[ "$#" = 0 ] || exit 1
[ -f "$profile" ] && [ ! -L "$profile" ] && [ -w "$profile" ] || exit 1
mode=$(stat -c %a "$profile") || exit 1
owner=$(stat -c %u "$profile") || exit 1
case "$mode" in ''|*[!0-7]*) exit 1 ;; esac
[ "$owner" = "$(id -u)" ] && [ "$((0$mode & 077))" = 0 ] && [ "$((0$mode & 0200))" != 0 ] || exit 1
value() { datconf -f "$profile" get "$1" 2>/dev/null; }
[ "$(value BhProfile0Valid)" = 1 ] || exit 1
ssid=$(value BhProfile0Ssid) || exit 1
key=$(value BhProfile0WpaPsk) || exit 1
auth=$(value BhProfile0AuthMode) || exit 1
enc=$(value BhProfile0EncrypType) || exit 1
case "$ssid$key" in *[![:print:]]*) exit 1 ;; esac
[ "${#ssid}" -ge 1 ] && [ "${#ssid}" -le 32 ] && [ "${#key}" -ge 8 ] && [ "${#key}" -le 63 ] || exit 1
case "$auth" in WPA2PSK|WPA2PSKWPA3PSK) ;; *) exit 1 ;; esac
[ "$enc" = AES ] || exit 1
