#!/bin/sh
# Preallocate the measured bounded pool; native WSC/M2 supplies agent SSIDs/keys.
set -eu
LC_ALL=C; export LC_ALL
umask 077
state=/etc/ax6000-mesh
base=$state/ts-agent-generations
lib=/usr/libexec
fail() { printf '%s\n' "$1" >&2; exit 1; }
get() { uci -q get "$1" 2>/dev/null || :; }
managed() { [ "$(get ax6000_mesh.main.enabled)" = 1 ] && [ "$(get ax6000_mesh.main.linux_ts)" = 1 ] && [ "$(get ax6000_mesh.main.role)" = agent ]; }
valid_generation() { case "$1" in ''|*[!0-9a-f]*) return 1 ;; esac; [ "${#1}" = 32 ]; }
selected() {
  generation=$(cat "$state/ts-agent-pending" 2>/dev/null || cat "$state/ts-agent-current" 2>/dev/null) || return 1
  valid_generation "$generation" && [ -d "$base/$generation" ] && [ ! -L "$base/$generation" ]
}
configs_match() {
  local name
  for name in network dhcp firewall ax6000_mesh; do
    cmp -s "/etc/config/$name" "$1/source-$name" || return 1
  done
}
validate_current() {
  managed && selected && configs_match "$base/$generation" || return 1
  cmp -s /etc/config/wireless "$base/$generation/staged/wireless" || return 1
  [ "$(sha256sum "$state/ts-capabilities.json" | cut -d' ' -f1)" = "$(cat "$base/$generation/capabilities.sha256")" ]
}
publish() {
  path=$base/$generation
  configs_match "$path" || fail 'Agent configuration changed after staging.'
  cmp -s /etc/config/wireless "$path/source-wireless" || cmp -s /etc/config/wireless "$path/staged/wireless" || fail 'Newer agent configuration conflicts with interrupted slot provisioning.'
  "$lib/ax6000-mesh-ts-supervise" stop >/dev/null 2>&1 || :
  /etc/init.d/ax6000-mesh stop 9>&- || fail 'Cannot stop native agent daemons.'
  if [ -f "$state/ts-ownership.json" ]; then
    "$lib/ax6000-mesh-ts-reconcile" prepare "$state/ts-ownership.json" >/dev/null || fail 'Cannot quarantine agent guests.'
    mv "$state/ts-ownership.json" "$state/ts-ownership.previous.json"
  fi
  "$lib/ax6000-mesh-control" quiesce-radios || fail 'Cannot quiesce agent topology.'
  cp "$path/staged/wireless" /etc/config/wireless.mesh-agent-new
  mv /etc/config/wireless.mesh-agent-new /etc/config/wireless
  sed '/^bss_config_priority=/d' /etc/map/1905d.cfg > "$path/1905.new"
  printf 'bss_config_priority=ra0;ra1;ra2;ra3;rax0;rax1;rax2;rax3;apcli0;apclix0\n' >> "$path/1905.new"
  cp "$path/1905.new" /etc/map/1905d.cfg.mesh-agent-new
  mv /etc/map/1905d.cfg.mesh-agent-new /etc/map/1905d.cfg
  "$lib/ax6000-mesh-transaction" adopt-agent-slots || fail 'Cannot seal agent slot intent.'
  "$lib/ax6000-mesh-control" restore-radios || fail 'Cannot start preallocated agent slots.'
  "$lib/ax6000-mesh-transaction" adopt-agent-slots || fail 'Cannot seal generated agent driver state.'
  /etc/init.d/ax6000-mesh start || fail 'Cannot start native managed agent.'
  "$lib/ax6000-mesh-transaction" adopt-agent-slots || fail 'Cannot seal native agent state.'
  printf '%s\n' "$generation" > "$state/ts-agent-current.new"
  mv "$state/ts-agent-current.new" "$state/ts-agent-current"; rm -f "$state/ts-agent-pending"; sync
}
once() {
  managed || return 0
  [ "$(cat /sys/class/net/br-lan/bridge/vlan_filtering 2>/dev/null)" = 1 ] && [ "$(cat /sys/class/net/br-lan/bridge/default_pvid 2>/dev/null)" = 0 ] || fail 'Prepare management-preserving filtered bridge with default PVID zero.'
  if [ -f "$state/ts-agent-pending" ]; then selected || fail 'Invalid pending agent generation.'; publish; return; fi
  current=$(cat "$state/ts-agent-current" 2>/dev/null || :)
  if valid_generation "$current"; then configs_match "$base/$current" || fail 'Local agent policy changed; controller-owned guest forwarding remains quarantined.'; fi
  generation=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n'); valid_generation "$generation" || fail 'Cannot create agent generation.'
  mkdir -p "$base"; chmod 700 "$base"; path=$base/$generation; mkdir -m 700 "$path"
  cp /etc/config/wireless "$path/source-wireless"
  for name in network dhcp firewall ax6000_mesh; do cp "/etc/config/$name" "$path/source-$name" || fail 'Cannot snapshot agent policy.'; done
  "$lib/ax6000-mesh-agent-slots" "$state/ts-capabilities.json" "$path/staged" || { rm -rf "$path"; fail 'Cannot stage measured agent capacity.'; }
  configs_match "$path" || { rm -rf "$path"; fail 'Agent policy changed during staging.'; }
  cmp -s /etc/config/wireless "$path/source-wireless" || { rm -rf "$path"; fail 'Agent Wi-Fi changed during staging.'; }
  digest=$(sha256sum "$state/ts-capabilities.json" | cut -d' ' -f1)
  current=$(cat "$state/ts-agent-current" 2>/dev/null || :)
  if valid_generation "$current" && cmp -s /etc/config/wireless "$path/staged/wireless" && [ "$digest" = "$(cat "$base/$current/capabilities.sha256")" ]; then rm -rf "$path"; return; fi
  printf '%s\n' "$digest" > "$path/capabilities.sha256"
  printf '%s\n' "$generation" > "$state/ts-agent-pending.new"
  mv "$state/ts-agent-pending.new" "$state/ts-agent-pending"; sync
  publish
}
preflight() (
  [ "$(id -u)" = 0 ] && [ "$(cat "$state/phase" 2>/dev/null)" = committed ] || fail 'Committed root staging is required.'
  [ "$(get ax6000_mesh.main.enabled):$(get ax6000_mesh.main.role)" = 1:agent ] || fail 'Enabled agent enrollment is required.'
  temp=$(mktemp -d "$state/.agent-preflight.XXXXXX") || fail 'Cannot stage bootstrap preflight.'
  trap 'rm -rf "$temp"' EXIT HUP INT TERM
  "$lib/ax6000-mesh-agent-slots" "$state/ts-capabilities.json" "$temp/staged"
)
case "${1-}" in
  preflight) [ "$#" = 1 ] || exit 1; preflight ;;
  validate-current) validate_current ;;
  once) [ "$(id -u)" = 0 ] || fail 'Agent provisioning requires root.'; exec 9>/var/lock/ax6000-mesh.lock; flock -n 9 || exit 0; once ;;
  monitor) while managed; do "$0" once || printf '%s\n' 'Agent slot provisioning remains pending.' > /var/run/ax6000-mesh-sync-error; sleep 30; done ;;
  *) fail 'Invalid agent synchronization operation.' ;;
esac
