#!/bin/sh
# The RPC entry point accepts only fixed operations and enumerated values.
set -eu
LC_ALL=C
export LC_ALL
umask 077
fail() { printf '%s\n' "$*" >&2; exit 1; }
get() { uci -q get "$1" 2>/dev/null || :; }
state=/etc/ax6000-mesh
config=/etc/config/wireless

abi_ok() {
  [ -f /etc/ax6000-mesh-abi.json ] || return 1
  digest=$(sha256sum /etc/ax6000-mesh-abi.json) || return 1
  [ "${digest%% *}" = 7fd55be3915c7c9ee84bcaf4698ba1c49efded4131164c01761ac1be7a8fd623 ]
}

phase() {
  [ ! -d /var/run/ax6000-mesh-operation ] || printf '%s\n' "$1" > /var/run/ax6000-mesh-operation/phase
}

preflight() {
  . /usr/share/ax6000-mesh/vendor.sh
  # Missing policy is an existing WPA2 installation, never an implicit migration.
  bh_security=$(get ax6000_mesh.main.backhaul_security); bh_security=${bh_security:-psk2}
  mesh_backhaul_auth_code "$bh_security" >/dev/null || fail 'Invalid backhaul security.'
  case "$bh_security" in sae) bh_driver_auth=WPA3PSK; bh_pmf=2 ;; psk2) bh_driver_auth=WPA2PSK; bh_pmf=0 ;; esac
  /usr/libexec/ax6000-mesh-band validate || fail 'Invalid wireless backhaul band.'
  /usr/libexec/ax6000-mesh-hardware supported || fail 'This device is not supported by Mesh.'
  abi_ok || fail 'This firmware does not contain the matching MediaTek mesh driver ABI.'
  for binary in wapp wappctrl mapd p1905_managerd mapd_cli; do command -v "$binary" >/dev/null || fail "Required daemon $binary is missing."; done
  [ -d /sys/class/net/br-lan ] || fail 'The br-lan bridge is required.'
  managed_ts=$(get ax6000_mesh.main.linux_ts)
  if [ "$managed_ts" = 1 ]; then
    [ "$(cat /sys/class/net/br-lan/bridge/vlan_filtering 2>/dev/null || :)" = 1 ] || fail 'Managed Mesh requires prepared VLAN filtering.'
    case "$(get ax6000_mesh.main.role)" in
      controller) /usr/libexec/ax6000-mesh-controller-sync validate-current || fail 'Controller managed generation is not prepared.' ;;
      agent) /usr/libexec/ax6000-mesh-agent-sync validate-current || fail 'Agent managed slots are not prepared.' ;;
      *) fail 'Invalid managed role.' ;;
    esac
  else
    [ "$(cat /sys/class/net/br-lan/bridge/vlan_filtering 2>/dev/null || :)" = 0 ] || fail 'Mesh requires a LAN bridge without VLAN filtering.'
  fi
  [ -d /sys/class/net/ra0 ] && [ -d /sys/class/net/rax0 ] || fail 'Both MediaTek AP radios must be active.'
  role=$(get ax6000_mesh.main.role); backhaul=$(get ax6000_mesh.main.backhaul)
  case "$role" in controller|agent) ;; *) fail 'Invalid mesh role.' ;; esac
  case "$backhaul" in wired|wireless) ;; *) fail 'Invalid backhaul.' ;; esac
  [ -z "$(uci -q changes wireless)" ] || fail 'Apply or discard pending wireless changes first.'
  aps=$(uci -q -X show wireless | sed -n "s/^wireless\.\([A-Za-z0-9_]*\)=wifi-iface$/\1/p")
  ap1= ap2= dev1= dev2= ssid24= key24= enc24= ssid5= key5= enc5=
  for ap in $aps; do
    case "$ap" in
      ax6000_mesh_ap1|ax6000_mesh_ap2|ax6000_mesh_bh1|ax6000_mesh_bh2)
        [ "$(get ax6000_mesh.main.enabled)" = 1 ] || fail 'A mesh-owned wireless section already exists.'
        continue ;;
    esac
    mode=$(get wireless.$ap.mode)
    [ "$mode" != sta ] || fail 'An existing wireless uplink must be removed before enabling Mesh.'
    [ "$mode" = ap ] || continue
    [ "$(get wireless.$ap.disabled)" != 1 ] || fail 'Remove disabled extra AP sections before enabling Mesh.'
    if [ "$managed_ts" = 1 ] && [ -z "$(get wireless.$ap.network)" ] && [ "$(get wireless.$ap.map_bss_type)" = 32 ]; then
      # Exact private staged UCI was validated above; guests stay unbridged until
      # native TS observation and Linux reconciliation verify their identities.
      continue
    fi
    [ "$(get wireless.$ap.network)" = lan ] || fail 'Client APs must belong only to LAN.'
    dev=$(get wireless.$ap.device)
    case "$dev" in ''|*[!A-Za-z0-9_]*) fail 'Invalid wireless device name.' ;; esac
    [ "$(get wireless.$dev.type)" = mtwifi ] || fail 'Only MediaTek radios are supported.'
    [ "$(get wireless.$ap.ieee80211r)" != 1 ] || fail 'Disable separate 802.11r settings before enabling Mesh.'
    band=$(get wireless.$dev.band)
    case "$band" in
      2g) [ "$dev" = "$(/usr/libexec/ax6000-mesh-hardware radio0)" ] || fail 'Wireless radio does not match this board.'; [ -z "$ap1" ] || fail 'Use one client AP on each radio.'; ap1=$ap; dev1=$dev ;;
      5g) [ "$dev" = "$(/usr/libexec/ax6000-mesh-hardware radio1)" ] || fail 'Wireless radio does not match this board.'; [ -z "$ap2" ] || fail 'Use one client AP on each radio.'; ap2=$ap; dev2=$dev ;;
      *) fail 'Expected 2.4 GHz and 5 GHz MediaTek radios.' ;;
    esac
    ap_ssid=$(get wireless.$ap.ssid); ap_key=$(get wireless.$ap.key); ap_enc=$(get wireless.$ap.encryption)
    if [ "$role" = controller ]; then
      [ "$managed_ts" = 1 ] || [ "$(get wireless.$ap.hidden)" != 1 ] || fail 'Client SSIDs must be visible for Mesh pairing.'
      mesh_validate_credentials "$ap_ssid" "$ap_key" "$ap_enc" || fail 'Client SSID or Wi-Fi password is invalid.'
      mesh_auth_code "$ap_enc" >/dev/null || fail 'Client APs must use WPA2-PSK or WPA2/WPA3 mixed mode.'
    fi
    if [ "$band" = 2g ]; then ssid24=$ap_ssid; key24=$ap_key; enc24=$ap_enc
    else ssid5=$ap_ssid; key5=$ap_key; enc5=$ap_enc; fi
  done
  [ -n "$ap1" ] && [ -n "$ap2" ] && [ "$dev1" != "$dev2" ] || fail 'One client AP on each MediaTek radio is required.'
  for port in lan2 lan3 lan4; do [ -e "/sys/class/net/br-lan/brif/$port" ] || fail 'Expected LAN ports lan2 through lan4 in br-lan.'; done
}

prepare() {
  prepare_committed=0
  if [ "$(cat "$state/phase" 2>/dev/null || :)" = committed ]; then
    # Verify ownership before changing any runtime or vendor configuration.
    /usr/libexec/ax6000-mesh-transaction adopt-radio-tuning || fail 'Mesh restart requires unchanged configuration or verified MU-MIMO tuning.'
    /usr/libexec/ax6000-mesh-transaction check || fail 'Mesh configuration changed outside enrollment; restore those edits before restarting Mesh.'
    [ -f /etc/map/1905d.cfg ] && [ ! -L /etc/map/1905d.cfg ] || fail 'Committed 1905 configuration is missing.'
    prepare_committed=1
  fi
  if [ ! -d /sys/module/mapfilter ]; then : > "$state/owns-mapfilter"; fi
  modprobe mapfilter >/dev/null 2>&1 || fail 'The MediaTek mapfilter kernel module is unavailable.'
  # The vendor driver keeps MAP R2/R3 and traffic separation as chip-wide flags.
  iwpriv ra0 set mapR3Enable=0 >/dev/null 2>&1 || fail 'Cannot disable MAP R3 in the driver.'
  iwpriv ra0 set mapR2Enable=1 >/dev/null 2>&1 || fail 'Cannot enable MAP R2 in the driver.'
  iwpriv ra0 set mapTSEnable=0 >/dev/null 2>&1 || fail 'Cannot disable traffic separation in the driver.'
  template=/usr/share/ax6000-mesh/vendor
  [ -f "$template/mapd_default.cfg" ] && [ -f "$template/1905d.cfg" ] || fail 'Mesh configuration templates are missing.'
  mkdir -p /etc/map
  chmod 700 /etc/map
  [ -f /etc/map/mapd_user.cfg ] || cp "$template/mapd_user.cfg" /etc/map/mapd_user.cfg
  chmod 600 /etc/map/mapd_user.cfg
  cp "$template/mapd_default.cfg" /etc/map/mapd_cfg
  # User profile persists the daemon's enrolled backhaul credentials.
  while IFS='=' read -r name value; do
    case "$name" in BhProfile[0-9]Valid|BhProfile[0-9]Ssid|BhProfile[0-9]AuthMode|BhProfile[0-9]EncrypType|BhProfile[0-9]WpaPsk|BhProfile[0-9]RaID) datconf -f /etc/map/mapd_cfg set "$name" "$value" >/dev/null 2>&1 || fail 'Cannot restore mesh backhaul profile.' ;; esac
  done < /etc/map/mapd_user.cfg
  # Reapply after each template/profile merge, including committed restarts.
  # This selects the uplink band without changing either fronthaul radio.
  if [ "$role:$backhaul" = agent:wireless ]; then
    /usr/libexec/ax6000-mesh-band apply || fail 'Cannot prepare wireless backhaul band priorities.'
  fi
  if [ "$role" = controller ]; then device_role=1; agent=0; root=1; else device_role=2; agent=1; root=0; fi
  lan_interfaces="lan2 lan3 lan4"
  [ "$role:$backhaul" != agent:wired ] || lan_interfaces="$lan_interfaces wan"
  bss_priority="ra0;ra1;rax0;rax1;apcli0;apclix0"
  [ "$managed_ts" != 1 ] || bss_priority="ra0;ra1;ra2;ra3;rax0;rax1;rax2;rax3;apcli0;apclix0"
  for entry in "bss_config_priority=$bss_priority" "DeviceRole=$device_role" "lan_interface=$lan_interfaces" 'wan_interface=' 'DhcpCtl=0' 'ChPlanningEnable=0' 'ChPlanningEnableR2=0' 'NetworkOptimizationEnabled=0' 'AutoBHSwitching=0'; do
    datconf -f /etc/map/mapd_cfg set "${entry%%=*}" "${entry#*=}" >/dev/null 2>&1 || fail 'Cannot prepare mesh settings.'
  done
  # 1905 persists its selected local ALID during enrollment. Replacing it
  # with br-lan on restart changes the sealed identity and blocks rollback.
  if [ "$prepare_committed" != 1 ]; then
    bh_type=eth
    if [ "$role" = agent ] && [ "$backhaul" = wireless ]; then bh_type=wifi; fi
    mac=$(cat /sys/class/net/br-lan/address)
    case "$mac" in ??\:??\:??\:??\:??\:??) ;; *) fail 'Invalid LAN bridge address.' ;; esac
    # Keep vendor defaults: missing gtk_rekey_interval creates a zero-delay rekey loop.
    sed -E '/^(map_controller_alid|map_agent_alid|map_agent|map_root|bh_type|br_inf|lan|map_ver|bss_config_priority)=/d' "$template/1905d.cfg" > /etc/map/1905d.cfg
    cat >> /etc/map/1905d.cfg <<END
map_controller_alid=$mac
map_agent_alid=$mac
map_agent=$agent
map_root=$root
bh_type=$bh_type
br_inf=br-lan
lan=lan2
lan=lan3
lan=lan4
map_ver=R2
bss_config_priority=$bss_priority
END
    [ "$role:$backhaul" != agent:wired ] || printf 'lan=wan\n' >> /etc/map/1905d.cfg
  fi
  read -r bh_ssid < "$state/backhaul-ssid"
  read -r bh_key < "$state/backhaul-key"
  if [ "$role" = agent ]; then
    # Agent client credentials are supplied by the controller via WSC/M2.
    # Initial placeholders are private and must not overwrite enrolled DATs.
    ssid24=AX6000-joining; ssid5=AX6000-joining; key24=$bh_key; key5=$bh_key; enc24=sae-mixed; enc5=sae-mixed
  fi
  if [ "$(cat "$state/phase" 2>/dev/null || :)" = committed ]; then
    [ -f /etc/map/wts_bss_info_config ] && [ ! -L /etc/map/wts_bss_info_config ] || fail 'Committed Mesh profile is missing.'
  else
    mesh_write_bss /etc/map/wts_bss_info_config "$ssid24" "$key24" "$enc24" "$ssid5" "$key5" "$enc5" "$bh_ssid" "$bh_key" "$bh_security" || fail 'Cannot prepare client and backhaul profiles.'
  fi
  cp "$template/ethernet_cfg.txt" /etc/ethernet_cfg.txt
  # Native 1905 DSA reads interface names; VLAN IDs alone do not identify LAN.
  printf '\nlan=%s\nbr_lan=br-lan\n' "$lan_interfaces" >> /etc/ethernet_cfg.txt
  cp "$template/wapp_ap_ra0.conf" /etc/wapp_ap_ra0.conf
  cp "$template/wapp_ap_rax0.conf" /etc/wapp_ap_rax0.conf
  printf 'conf_list=/etc/wapp_ap_ra0.conf;/etc/wapp_ap_rax0.conf;\n' > /etc/wapp_ap.conf
  printf 'all_main_inf=ra0;rax0;\n' > /etc/wapp_main_inf.conf
  chmod 600 /etc/map/1905d.cfg /etc/map/mapd_cfg /etc/map/wts_bss_info_config
  if [ ! -f /etc/mapd_strng.conf ]; then
    cat > /etc/mapd_strng.conf <<'END'
LowRSSIAPSteerEdge_RE=40
CUOverloadTh_2G=70
CUOverloadTh_5G_L=80
CUOverloadTh_5G_H=80
MetricPolicyChUtilThres_24G=70
MetricPolicyChUtilThres_5GL=80
MetricPolicyChUtilThres_5GH=80
ChPlanningChUtilThresh_24G=70
ChPlanningChUtilThresh_5GL=80
ChPlanningEDCCAThresh_24G=200
ChPlanningEDCCAThresh_5GL=200
ChPlanningOBSSThresh_24G=200
ChPlanningOBSSThresh_5GL=200
ChPlanningR2MonitorTimeoutSecs=300
ChPlanningR2MonitorProhibitSecs=900
ChPlanningR2MetricReportingInterval=10
ChPlanningR2MinScoreMargin=20
MetricRepIntv=10
MetricPolicyRcpi_24G=100
MetricPolicyRcpi_5GL=100
MetricPolicyRcpi_5GH=100
END
  fi
}

wait_radios() {
  local mesh_ready_now mesh_ready_deadline
  read -r mesh_ready_now _ < /proc/uptime; mesh_ready_now=${mesh_ready_now%%.*}
  mesh_ready_deadline=$((mesh_ready_now + 150))
  while [ "$mesh_ready_now" -lt "$mesh_ready_deadline" ]; do
    ready=1
    for radio in ra0 rax0; do
      flags=$(cat "/sys/class/net/$radio/flags" 2>/dev/null || :)
      case "$flags" in 0x[0-9a-fA-F]*) [ "$((flags & 1))" -eq 1 ] || ready=0 ;; *) ready=0 ;; esac
    done
    if [ "$ready" = 1 ] && wifi isup >/dev/null 2>&1; then return 0; fi
    sleep 1
    read -r mesh_ready_now _ < /proc/uptime; mesh_ready_now=${mesh_ready_now%%.*}
  done
  return 1
}

disconnect_backhaul() {
  local mesh_iface mesh_flags
  uci -q set ax6000_mesh.main.enabled=0
  uci -q commit ax6000_mesh
  /etc/init.d/ax6000-mesh stop 9>&- >/dev/null 2>&1 || :
  rm -f /var/run/ax6000-mesh-pairing
  for mesh_iface in apcli0 apclix0; do
    [ -d "/sys/class/net/$mesh_iface" ] || continue
    mesh_flags=$(cat "/sys/class/net/$mesh_iface/flags") || return 1
    [ "$((mesh_flags & 1))" != 0 ] || continue
    iwpriv "$mesh_iface" set ApCliEnable=0 >/dev/null 2>&1 || return 1
    ip link set dev "$mesh_iface" down || return 1
  done
}

radios_down() {
  local mesh_status mesh_devices mesh_device mesh_count=0 mesh_interface mesh_flags
  mesh_status=$(ubus call network.wireless status 2>/dev/null) || return 1
  [ -n "$mesh_status" ] || return 1
  mesh_devices=$(uci -q -X show wireless | sed -n 's/^wireless\.\([A-Za-z0-9_]*\)=wifi-device$/\1/p')
  for mesh_device in $mesh_devices; do
    [ "$(get wireless.$mesh_device.type)" = mtwifi ] || continue
    mesh_count=$((mesh_count + 1))
    [ "$(jsonfilter -s "$mesh_status" -e "@.$mesh_device.up" 2>/dev/null)" = false ] || return 1
    [ "$(jsonfilter -s "$mesh_status" -e "@.$mesh_device.pending" 2>/dev/null)" = false ] || return 1
  done
  [ "$mesh_count" = 2 ] || return 1
  for mesh_interface in ra0 ra1 rax0 rax1 apcli0 apclix0; do
    [ -d "/sys/class/net/$mesh_interface" ] || continue
    mesh_flags=$(cat "/sys/class/net/$mesh_interface/flags") || return 1
    case "$mesh_flags" in 0x[0-9a-fA-F]*) [ "$((mesh_flags & 1))" = 0 ] || return 1 ;; *) return 1 ;; esac
  done
}

lock_radios() {
  local mesh_attempt=0
  exec 8>/var/lock/mtwifi.lock
  while ! flock -n 8; do
    [ "$mesh_attempt" -lt 30 ] || return 1
    mesh_attempt=$((mesh_attempt + 1)); sleep 1
  done
}

valid_radio_modules() {
  local mesh_module
  [ -f "$state/radio-modules" ] && [ ! -L "$state/radio-modules" ] || return 1
  grep -qx mt_wifi "$state/radio-modules" || return 1
  while read -r mesh_module; do
    case "$mesh_module" in mtk_warp_proxy|mtk_warp|mt_wifi) ;; *) return 1 ;; esac
  done < "$state/radio-modules"
}

# Restore DAT only after unloading the adapter with its original BSSID count.
# A subshell releases the driver lock on every failure as well as success.
quiesce_radios() (
  local mesh_attempt=0 mesh_module mesh_interface
  timeout 20 wifi down 9>&- >/dev/null 2>&1 || return 1
  until radios_down; do
    [ "$mesh_attempt" -lt 45 ] || return 1
    mesh_attempt=$((mesh_attempt + 1)); sleep 1
  done
  lock_radios || return 1
  radios_down || return 1
  [ -d "$state" ] && [ ! -L "$state" ] || return 1
  if [ ! -e "$state/radio-modules" ]; then
    [ -d /sys/module/mt_wifi ] || return 1
    # Keep this first module set through partial unloads and restoration retries.
    for mesh_module in mtk_warp_proxy mtk_warp mt_wifi; do
      [ ! -d "/sys/module/$mesh_module" ] || printf '%s\n' "$mesh_module"
    done > "$state/radio-modules.new" || return 1
    mv "$state/radio-modules.new" "$state/radio-modules" || return 1
    sync || return 1
  fi
  valid_radio_modules || return 1
  for mesh_module in mtk_warp_proxy mtk_warp mt_wifi; do
    [ -d "/sys/module/$mesh_module" ] || continue
    timeout 20 rmmod "$mesh_module" 8>&- 9>&- >/dev/null 2>&1 || return 1
  done
  for mesh_module in mtk_warp_proxy mtk_warp mt_wifi; do
    [ ! -d "/sys/module/$mesh_module" ] || return 1
  done
  for mesh_interface in ra0 ra1 rax0 rax1 apcli0 apclix0; do
    [ ! -e "/sys/class/net/$mesh_interface" ] || return 1
  done
)

restore_radios() {
  (
    local mesh_module
    lock_radios || exit 1
    valid_radio_modules || exit 1
    for mesh_module in mt_wifi mtk_warp mtk_warp_proxy; do
      grep -qx "$mesh_module" "$state/radio-modules" || continue
      [ -d "/sys/module/$mesh_module" ] && continue
      timeout 20 modprobe "$mesh_module" 8>&- 9>&- >/dev/null 2>&1 || exit 1
      [ -d "/sys/module/$mesh_module" ] || exit 1
    done
    [ -d /sys/module/mt_wifi ] || exit 1
  ) || return 1
  # The pinned wifi up command reloads network configuration before setup.
  # It must acquire mtwifi.lock itself, after the subshell releases descriptor 8.
  timeout 20 wifi up 9>&- >/dev/null 2>&1 || return 1
  wait_radios || return 1
  iwpriv ra0 set mapR2Enable=0 >/dev/null 2>&1 || return 1
  iwpriv ra0 set mapTSEnable=0 >/dev/null 2>&1 || return 1
}

restore() {
  disconnect_backhaul || return 1
  /usr/libexec/ax6000-mesh-transaction rollback "${1:-failure}"
}

lease_ok() {
  local mesh_lan mesh_address
  mesh_lan=$(ubus call network.interface.lan status 2>/dev/null) || return 1
  [ "$(printf '%s' "$mesh_lan" | jsonfilter -e '@.up')" = true ] || return 1
  [ "$(printf '%s' "$mesh_lan" | jsonfilter -e '@.proto')" = dhcp ] || return 1
  mesh_address=$(printf '%s' "$mesh_lan" | jsonfilter -e '@["ipv4-address"][0].address')
  case "$mesh_address" in ''|0.*|127.*|169.254.*) return 1 ;; esac
  [ "$(printf '%s' "$mesh_address" | awk -F. 'NF==4 { for(i=1;i<=4;i++) if ($i !~ /^[0-9]+$/ || $i>255) exit; print "valid" }')" = valid ]
}

pair_mesh() {
  local mesh_result mesh_message
  [ "$(get ax6000_mesh.main.enabled)" = 1 ] || fail 'Mesh is not enabled.'
  mesh_result=$(/usr/libexec/ax6000-mesh-vendor pair) || fail 'Wireless pairing could not be started.'
  if [ "$(printf '%s' "$mesh_result" | jsonfilter -e '@.ok')" != true ]; then
    mesh_message=$(printf '%s' "$mesh_result" | jsonfilter -e '@.error')
    fail "${mesh_message:-Wireless pairing could not be started.}"
  fi
}

apply_mesh() {
  [ "$(get ax6000_mesh.main.enabled)" != 1 ] || fail 'Mesh is already enabled; disable it before changing its role.'
  preflight
  phase preparing
  for binary in wapp mapd p1905_managerd; do ! pidof "$binary" >/dev/null || fail "A $binary process is already running."; done
  /usr/libexec/ax6000-mesh-transaction begin "$role" "$backhaul" || fail 'Could not save a complete recovery snapshot.'
  success=0
  trap '[ "$success" = 1 ] || [ "$(cat "$state/phase" 2>/dev/null || :)" = committed ] || { if restore; then phase restored; else printf "%s\n" "Restore failed; recovery snapshot retained." >&2; fi; }' EXIT
  trap 'exit 1' HUP INT TERM
  if [ "$role:$backhaul" = agent:wireless ]; then
    /usr/libexec/ax6000-mesh-profile reset || fail 'Could not prepare a fresh wireless backhaul profile.'
  fi
  if [ "$role" = agent ]; then /usr/libexec/ax6000-mesh-transaction prepare-agent || fail 'Could not prepare the additional node network.'; fi
  bh_random=$(head -c 32 /dev/urandom | sha256sum)
  bh_key=$(printf '%.32s' "${bh_random%% *}")
  bh_ssid="AX6000-BH-$(printf '%.12s' "${bh_random%% *}")"
  [ "${#bh_key}" = 32 ] || fail 'Could not create backhaul credentials.'
  printf '%s\n' "$bh_ssid" > "$state/backhaul-ssid"
  printf '%s\n' "$bh_key" > "$state/backhaul-key"
  [ -d /sys/module/mapfilter ] || : > "$state/owns-mapfilter"
  modprobe mapfilter >/dev/null 2>&1 || fail 'The MediaTek mapfilter kernel module is unavailable.'
  for index in 1 2; do
    if [ "$index" = 1 ]; then device=$dev1; client=$ap1; else device=$dev2; client=$ap2; fi
    uci -q set "wireless.$device.map_mode=1"
    if [ "$role" = agent ]; then agent=1; else agent=0; fi
    uci -q set "wireless.$device.map_agent=$agent"
    uci -q set "wireless.$client.map_bss_type=32"
    if [ "$role" = agent ]; then
      uci -q set "wireless.$client.ssid=AX6000-joining"
      uci -q set "wireless.$client.key=$bh_key"
      uci -q set "wireless.$client.encryption=sae-mixed"
      uci -q set "wireless.$client.hidden=0"
    fi
    section="ax6000_mesh_ap$index"
    uci -q set "wireless.$section=wifi-iface"
    uci -q set "wireless.$section.device=$device"
    uci -q set "wireless.$section.mode=ap"
    uci -q set "wireless.$section.network=lan"
    uci -q set "wireless.$section.ssid=$bh_ssid"
    uci -q set "wireless.$section.key=$bh_key"
    uci -q set "wireless.$section.encryption=$bh_security"
    uci -q set "wireless.$section.ieee80211w=$bh_pmf"
    uci -q set "wireless.$section.hidden=1"
    # Driver A4 backhaul must not reflect multicast frames to its ingress.
    uci -q set "wireless.$section.multicast_to_unicast=0"
    uci -q set "wireless.$section.map_bss_type=64"
    if [ "$role:$backhaul" = agent:wireless ]; then
      section="ax6000_mesh_bh$index"
      uci -q set "wireless.$section=wifi-iface"
      uci -q set "wireless.$section.device=$device"
      uci -q set "wireless.$section.mode=sta"
      uci -q set "wireless.$section.network=lan"
      uci -q set "wireless.$section.ssid=mesh-backhaul"
    fi
  done
  uci -q commit wireless
  uci -q set ax6000_mesh.main.enabled=1
  uci -q commit ax6000_mesh
  if [ "$role" = agent ]; then
    # The converter deliberately preserves enrolled agent DAT credentials.
    # Seed both new BSS slots securely before its first ownership handover.
    for radio in ra0 rax0 ra1 rax1; do
      case "$radio" in *0) mesh_seed_ssid=AX6000-joining; mesh_seed_auth=WPA2PSKWPA3PSK; mesh_seed_hidden=0 ;;
        *) mesh_seed_ssid=$bh_ssid; mesh_seed_auth=$bh_driver_auth; mesh_seed_hidden=1 ;; esac
      wifi_config_save "$radio" SSID "$mesh_seed_ssid"
      wifi_config_save "$radio" WPAPSK "$bh_key"
      wifi_config_save "$radio" AuthMode "$mesh_seed_auth"
      wifi_config_save "$radio" EncrypType AES
      wifi_config_save "$radio" HideSSID "$mesh_seed_hidden"
    done
  fi
  /usr/libexec/ax6000-mesh-transaction seal || fail 'Could not record the prepared configuration.'
  if [ "$role" = agent ]; then /etc/init.d/network reload 9>&- >/dev/null 2>&1 || fail 'Agent network reload failed.'; fi
  wifi reload 9>&- >/dev/null 2>&1 || fail 'Wireless reload failed.'
  wait_radios || fail 'Wireless radios did not become ready.'
  if ! start_error=$(/etc/init.d/ax6000-mesh start 9>&- 2>&1); then fail "Mesh service failed to start. $(printf '%.256s' "$start_error")"; fi
  read -r mesh_health_now _ < /proc/uptime; mesh_health_now=${mesh_health_now%%.*}
  mesh_health_deadline=$((mesh_health_now + 30)); mesh_healthy=0
  while [ "$mesh_health_now" -lt "$mesh_health_deadline" ]; do
    if /usr/libexec/ax6000-mesh-health; then mesh_healthy=1; break; fi
    sleep 1
    read -r mesh_health_now _ < /proc/uptime; mesh_health_now=${mesh_health_now%%.*}
  done
  [ "$mesh_healthy" = 1 ] || fail 'Mesh services did not become ready.'
  if [ "$role" = agent ]; then
    if [ "$backhaul" = wireless ]; then phase pairing; pair_mesh; else phase address; fi
    read -r mesh_now _ < /proc/uptime; mesh_now=${mesh_now%%.*}
    mesh_join_deadline=$((mesh_now + 180)); mesh_joined=0; mesh_profile_missing=0
    while [ "$mesh_now" -lt "$mesh_join_deadline" ]; do
      enrollment=$(/usr/libexec/ax6000-mesh-vendor status) || enrollment='{}'
      if [ "$(printf '%s' "$enrollment" | jsonfilter -e '@.connected')" = true ]; then
        phase address
        if lease_ok; then
          if [ "$backhaul" != wireless ] || /usr/libexec/ax6000-mesh-profile; then
            mesh_joined=1; break
          fi
          mesh_profile_missing=1
        fi
      fi
      sleep 1
      read -r mesh_now _ < /proc/uptime; mesh_now=${mesh_now%%.*}
    done
    if [ "$mesh_joined" != 1 ]; then
      [ "$mesh_profile_missing" = 0 ] || fail 'The wireless backhaul profile was not saved safely.'
      fail 'The node did not join a controller and receive an address.'
    fi
    phase connected
  else phase ready; fi
  /usr/libexec/ax6000-mesh-transaction commit || fail 'Could not commit the Mesh configuration.'
  success=1
  trap - EXIT HUP INT TERM
}

disable_mesh() {
  if [ "$(cat "$state/phase" 2>/dev/null || :)" = pending ] && /usr/libexec/ax6000-mesh-transaction present; then
    : # A previous restoration was interrupted; retry from the valid snapshot.
  else
    /usr/libexec/ax6000-mesh-transaction check || fail 'Configuration changed after Mesh setup; restore those edits before disabling Mesh.'
  fi
  restore disable || fail 'Restore failed; recovery snapshot retained.'
}

case "${1:-}" in
  configure|apply|disable|pair)
    exec 9>/var/lock/ax6000-mesh.lock
    flock -n 9 || fail 'Another mesh operation is in progress.'
    ;;
esac
case "${1:-}" in
 configure)
  [ "$#" -ge 3 ] && [ "$#" -le 5 ] || fail 'Expected role, backhaul, and optional security and band.'
  case "$2" in controller|agent) ;; *) fail 'Invalid mesh role.' ;; esac
  case "$3" in wired|wireless) ;; *) fail 'Invalid backhaul.' ;; esac
  configure_security=$(get ax6000_mesh.main.backhaul_security); configure_security=${configure_security:-psk2}
  configure_band=$(uci -q get ax6000_mesh.main.backhaul_band 2>/dev/null) || configure_band=auto
  configure_security=${4-$configure_security}; configure_band=${5-$configure_band}
  case "$configure_security" in sae|psk2) ;; *) fail 'Invalid backhaul security.' ;; esac
  case "$configure_band" in auto|5g|2g) ;; *) fail 'Invalid wireless backhaul band.' ;; esac
  [ "$(get ax6000_mesh.main.enabled)" != 1 ] || fail 'Disable mesh before changing its role or backhaul.'
  if [ "$(cat "$state/phase" 2>/dev/null || :)" = pending ] && /usr/libexec/ax6000-mesh-transaction present; then fail 'Restore the previous settings before configuring Mesh.'; fi
  uci -q set ax6000_mesh.main=mesh
  uci -q set "ax6000_mesh.main.role=$2"
  uci -q set "ax6000_mesh.main.backhaul=$3"
  # Legacy callers preserve the saved policy, including absent legacy fields.
  [ "$#" -lt 4 ] || uci -q set "ax6000_mesh.main.backhaul_security=$4"
  [ "$#" -lt 5 ] || uci -q set "ax6000_mesh.main.backhaul_band=$5"
  uci -q commit ax6000_mesh
  ;;
 apply) apply_mesh ;;
 disable) disable_mesh ;;
 pair) pair_mesh ;;
 disconnect-backhaul) disconnect_backhaul ;;
 quiesce-radios) quiesce_radios ;;
 restore-radios) restore_radios ;;
 abi) abi_ok ;;
 preflight) preflight ;;
 prepare) preflight; prepare ;;
 *) fail 'Unknown mesh command.' ;;
esac
