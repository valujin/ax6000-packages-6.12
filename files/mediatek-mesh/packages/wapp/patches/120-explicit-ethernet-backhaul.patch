+/* Explicit Ethernet onboarding must use the caller's real interface. */
+static int map_set_eth_bh_explicit(struct wifi_app *wapp, char *eth_ifname)
+{
+	struct bh_type_info bh = {0};
+	u8 mac_addr[MAC_ADDR_LEN] = {0};
+
+	if (!wapp->map || !wapp->map->TurnKeyEnable || !eth_ifname ||
+		!eth_ifname[0] || os_strlen(eth_ifname) >= IFNAMSIZ ||
+		strspn(eth_ifname, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.:-") != os_strlen(eth_ifname))
+		return WAPP_INVALID_ARG;
+	if (wapp_get_mac_addr_by_ifname(eth_ifname, mac_addr) != WAPP_SUCCESS ||
+		is_zero_ether_addr(mac_addr) || is_multicast_ether_addr(mac_addr))
+		return WAPP_INVALID_ARG;
+
+	bh.type = MAP_BH_ETH;
+	if (wapp_send_1905_msg(wapp, WAPP_SET_BH_TYPE, sizeof(bh), (char *)&bh) != 0)
+		return WAPP_UNEXP;
+	wapp->map->bh_type = MAP_BH_ETH;
+	if (map_bh_ready(wapp, MAP_BH_ETH, (u8 *)eth_ifname, mac_addr, mac_addr) != 0)
+		return WAPP_UNEXP;
+	return WAPP_SUCCESS;
+}
