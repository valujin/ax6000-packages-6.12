diff --git a/feeds/luci/modules/luci-mod-network/root/etc/uci-defaults/95-ax6000-mesh-wireless-vendor b/feeds/luci/modules/luci-mod-network/root/etc/uci-defaults/95-ax6000-mesh-wireless-vendor
