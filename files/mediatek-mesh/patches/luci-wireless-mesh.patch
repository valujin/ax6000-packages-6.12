--- /dev/null
+++ b/feeds/luci/modules/luci-mod-network/root/etc/uci-defaults/95-ax6000-mesh-wireless-vendor
@@ -0,0 +1,15 @@
+#!/bin/sh
+# Reapply the installed vendor implementation after a core package update.
+mesh_vendor=/usr/share/luci-app-mtwifi-cfg/wireless-mtk.js
+mesh_active=/www/luci-static/resources/view/network/wireless.js
+[ -e "$mesh_vendor" ] || { [ ! -L "$mesh_vendor" ] && exit 0; exit 1; }
+[ -f "$mesh_vendor" ] && [ ! -L "$mesh_vendor" ] || exit 1
+[ "$(readlink -f "$mesh_vendor")" = "$mesh_vendor" ] || exit 1
+[ "$(stat -c %u:%g:%a "$mesh_vendor")" = 0:0:644 ] || exit 1
+mesh_directory=${mesh_active%/*}
+[ -d "$mesh_directory" ] && [ "$(readlink -f "$mesh_directory")" = "$mesh_directory" ] || exit 1
+[ "$(stat -c %u "$mesh_directory")" = 0 ] && [ ! -L "$mesh_active" ] || exit 1
+mesh_temporary=$(mktemp "$mesh_directory/.wireless-mtk.XXXXXX") || exit 1
+trap 'rm -f "$mesh_temporary"' EXIT HUP INT TERM
+cp -p "$mesh_vendor" "$mesh_temporary" && mv -f "$mesh_temporary" "$mesh_active" || exit 1
+exit 0
