 	if (!is_dbdc) return;
 
 	// for DBDC cards, restore sibling devs
 	if (diff_res.need_reload) {
 		// in driver reload situation, 
 		// let another process to handle sib devs setup
 		for (let idx, devname in down_devnames) {
 			if (!(devname == cur_devname)) {
